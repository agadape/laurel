# Copy to .env and fill in. Never commit .env. All accounts are NEAR TESTNET.
# tools/*.mjs read this file from the repository root.

# --- the one account a judge needs (≥ 6 NEAR for tools/e2e.mjs; browser faucet: https://near-faucet.io) ---
TEAM_ACCOUNT_ID=
TEAM_PRIVATE_KEY=

# --- optional: which Bursa contract the scripts talk to (default: BURSA_DEV_ID) ---
BURSA_CONTRACT_ID=
BURSA_DEV_ID=bursa-dev.nh-ft-mvp6pidf.testnet   # dev contract (history); final: BURSA_CONTRACT_ID=laurel.laurel-team-mw0x0c8g.testnet

# --- optional: pinned evaluator and the OutLayer secret owner used by e2e (defaults are the team's public ones) ---
EVALUATOR_URL=https://nh-spike-wasm.vercel.app/8b80010fc79259c9f5d95183a660e79ad7a450fdfceed3e8ce0924f296b60ac3.wasm
EVALUATOR_HASH=8b80010fc79259c9f5d95183a660e79ad7a450fdfceed3e8ce0924f296b60ac3
SECRETS_ACCOUNT=nh-spike-mvp62mw4.testnet

# --- optional extra signers used by submit.mjs / predict.mjs / agent.mjs / consumer.mjs ---
P1_ACCOUNT_ID=
P1_PRIVATE_KEY=
P2_ACCOUNT_ID=
P2_PRIVATE_KEY=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
AGENT_FC_PRIVATE_KEY=
DESK_ACCOUNT_ID=
DESK_PRIVATE_KEY=

# --- team-internal spike accounts (see docs/TESTNET.md); not needed by judges ---
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_FT_CONTRACT_ID=
NEAR_FT_CONTRACT_PRIVATE_KEY=
NEAR_NFT_CONTRACT_ID=
NEAR_NFT_CONTRACT_PRIVATE_KEY=
NEAR_MT_CONTRACT_ID=
NEAR_MT_CONTRACT_PRIVATE_KEY=
NEAR_S22_CONTRACT_ID=
NEAR_S22_CONTRACT_PRIVATE_KEY=
NEAR_S31_CONTRACT_ID=
NEAR_S31_CONTRACT_PRIVATE_KEY=
